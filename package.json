{
  "name": "node-todo-final",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.mjs",
    "dev": "node --watch --env-file=.env src/index.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:start": "docker compose --env-file .env.database up -d --wait",
    "db:stop": "docker compose --env-file .env.database stop",
    "db:init": "node --env-file=.env --env-file=.env.database scripts/init-db.mjs",
    "assets": "node scripts/assets.mjs",
    "helios:prepare": "sh scripts/helios.sh prepare",
    "helios:init-db": "sh scripts/helios.sh init-db",
    "helios:deploy": "sh scripts/helios.sh deploy",
    "helios:preview": "sh scripts/helios.sh preview",
    "helios:status": "sh scripts/helios.sh status",
    "helios:start": "sh scripts/helios.sh start",
    "helios:stop": "sh scripts/helios.sh stop",
    "helios:rollback": "sh scripts/helios.sh rollback",
    "test": "node --test tests/unit/*.test.mjs",
    "test:deployment": "node --test --test-concurrency=1 tests/deployment/*.test.mjs",
    "test:apache": "node tests/helpers/apache-gateway.mjs",
    "test:integration": "node --env-file=.env.database --test --test-concurrency=1 tests/integration/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "token": "node --env-file=.env -e \"process.stdout.write(process.env.API_TOKEN + '\\n')\""
  },
  "dependencies": {
    "express": "5.3.0",
    "mongodb": "7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "^17.14.0",
    "lucide-static": "1.71.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
